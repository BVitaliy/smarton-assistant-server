# Налаштування сервера AI-консультанта (npm start).
# Скопіювати в `.env.server` поруч (його немає в git) і заповнити.
# Ключі — лише тут, на сервері; ніколи в git, чатах, листах.

# Де слухати. Назовні — лише через nginx, тож 127.0.0.1.
HOST=127.0.0.1
PORT=8787

# --- Модель ---------------------------------------------------------------------
# Яку модель використовує помічник, задається ТУТ (на Render — Environment),
# не в апках: апки й адмінка працюють з будь-яким провайдером без нового білда.
# Після зміни — Save / Manual Deploy, щоб сервер перезапустився.
#
# ASSISTANT_PROVIDER: anthropic (за замовчуванням) | openai | openrouter | compatible
# ASSISTANT_MODEL:    id моделі провайдера (для openrouter — до 3 через кому: основна й запасні)
# ASSISTANT_VISION_MODEL: модель для питань зі скріншотом (адмінка); не задано — та сама
# ASSISTANT_REASONING: off | low | medium | high — лише openai/openrouter/compatible
#
# Будь-яку змінну можна задати окремо для апки, додавши суфікс tenant-а:
#   _SMARTON (апка SMARTon), _PRONTO (Pronto), _SMARTON_ADMIN (адмінка).
# Без суфікса — для всіх. Приклад: адмінка на GPT, решта на Claude:
#   ASSISTANT_PROVIDER=anthropic
#   ASSISTANT_PROVIDER_SMARTON_ADMIN=openai
#   ASSISTANT_MODEL_SMARTON_ADMIN=<id моделі OpenAI>

# 1) Claude напряму. Ключ: https://platform.claude.com/settings/keys
#    ASSISTANT_MODEL не задано — Claude Haiku 5.5 (підходять Claude 4.6 і новіші).
ANTHROPIC_API_KEY=

# 2) GPT напряму (OpenAI). ASSISTANT_MODEL обов'язковий.
# ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=   # лише для Azure OpenAI чи проксі

# 3) OpenRouter: одним ключем сотні моделей (Claude, GPT, Gemini, безкоштовні).
#    Безкоштовні (`:free`) — лише для внутрішнього демо: ліміт ~50 запитів/добу,
#    провайдери можуть зберігати запити; потрібен ASSISTANT_ALLOW_DEMO_PROVIDER=true.
# ASSISTANT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# ASSISTANT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free
# ASSISTANT_ALLOW_DEMO_PROVIDER=true
#    (старі назви OPENROUTER_MODEL / OPENROUTER_VISION_MODEL / OPENROUTER_REASONING теж працюють)

# 4) Будь-який API у форматі OpenAI: Gemini, DeepSeek, Mistral, Groq, свій сервер.
# ASSISTANT_PROVIDER=compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=
# ASSISTANT_MODEL=

# Ключі теж можна мати окремі для апки: OPENROUTER_API_KEY_SMARTON_ADMIN тощо.

# --- Гості (без входу) -----------------------------------------------------------
# У проді гостьові запити приймаються лише зі справжньої апки (Firebase App
# Check). Потрібен службовий ключ Firebase-проєкту (JSON) — шлях до файлу:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/smarton-assistant/firebase-service-account.json

# Поки App Check не зареєстровано (DeviceCheck / Play Integrity), для
# внутрішнього демо перевірку можна вимкнути. У проді — прибрати цей рядок.
# ASSISTANT_GUEST_APP_CHECK=off

# Кеш готових відповідей (потребує Firestore) — поки вимкнено.
ASSISTANT_ANSWER_CACHE=off
