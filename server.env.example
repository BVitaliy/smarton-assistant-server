# Налаштування сервера AI-консультанта (npm start).
# Скопіювати в `.env.server` поруч (його немає в git) і заповнити.
# Ключі — лише тут, на сервері; ніколи в git, чатах, листах.

# Де слухати. Назовні — лише через nginx, тож 127.0.0.1.
HOST=127.0.0.1
PORT=8787

# --- Модель ---------------------------------------------------------------------
# Прод: Claude. Ключ: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Внутрішнє демо (TestFlight для команди) на безкоштовних моделях OpenRouter.
# Для реальних користувачів НЕ вмикати: ліміт ~50 запитів/добу і провайдери
# можуть зберігати запити. Щоб увімкнути — розкоментувати всі чотири рядки.
# ASSISTANT_PROVIDER=openrouter
# ASSISTANT_ALLOW_DEMO_PROVIDER=true
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Гості (без входу) -----------------------------------------------------------
# У проді гостьові запити приймаються лише зі справжньої апки (Firebase App
# Check). Потрібен службовий ключ Firebase-проєкту (JSON) — шлях до файлу:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/smarton-assistant/firebase-service-account.json

# Поки App Check не зареєстровано (DeviceCheck / Play Integrity), для
# внутрішнього демо перевірку можна вимкнути. У проді — прибрати цей рядок.
# ASSISTANT_GUEST_APP_CHECK=off

# Кеш готових відповідей (потребує Firestore) — поки вимкнено.
ASSISTANT_ANSWER_CACHE=off
